# Preencha estas variáveis quando formos implementar autenticação e a análise de fundos.
# A busca de cotação (/cotacao) já funciona sem nada aqui — o token da Brapi
# fica em server/.env, nunca neste arquivo do frontend.

# Supabase — criar projeto em https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic — para a análise de PDF de relatório gerencial
# Vai rodar em função de backend (Supabase Edge Function), nunca exposta no frontend.
ANTHROPIC_API_KEY=

# Opcional: se o servidor local de proxy (server/) rodar em outra porta/host.
VITE_API_BASE_URL=http://localhost:3001
